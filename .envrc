# gh-stars/.envrc
#
# Loader for direnv. Tracked in git (no secrets here).
# Real secrets live in .envrc.local (gitignored) which typically reads from `pass`.

# Load local overrides if they exist (ignored by git)
if [ -f .envrc.local ]; then
  source_env .envrc.local
fi

# Fallback to .env if present (legacy support)
if [ -f .env ]; then
  dotenv .env
fi

# Default local output to the workspace Obsidian vault when no override is set.
if [ -z "$KNOWLEDGE_BASE_DIR" ] && [ -d ../knowledge ]; then
  export KNOWLEDGE_BASE_DIR="$(cd ../knowledge && pwd)"
fi

# Validation
if [ -z "$GITHUB_PAT_TOKEN" ]; then
  echo "⚠️  GITHUB_PAT_TOKEN is missing."
  echo "    Set it in .envrc.local, e.g.:"
  echo "      export GITHUB_PAT_TOKEN=\$(pass dev/github/pat-agent)"
fi

if [ -z "$ANTHROPIC_API_KEY" ]; then
  echo "⚠️  ANTHROPIC_API_KEY is missing."
  echo "    Set it in .envrc.local, e.g.:"
  echo "      export ANTHROPIC_API_KEY=\$(pass ai/anthropic/api-key)"
fi
